<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/vlOptionSelected" />
            <stroke android:width="1.5dp" android:color="?attr/vlAccent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/vlInputBg" />
            <stroke android:width="1dp" android:color="?attr/vlInputStroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
