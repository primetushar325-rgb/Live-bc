<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="?attr/vlAccent"
                android:endColor="?attr/vlAccentSoft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/vlChipBg" />
            <stroke android:width="1dp" android:color="?attr/vlInputStroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
