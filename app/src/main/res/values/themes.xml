<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VideoLive" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/bg_top</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlHighlight">#335B8CFF</item>
        <item name="materialAlertDialogTheme">@style/Theme.VideoLive.Dialog</item>
    </style>

    <style name="Theme.VideoLive.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/card_bg</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
