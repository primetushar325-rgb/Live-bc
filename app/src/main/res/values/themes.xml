<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base: every surface/text/accent reads from the themeable attrs so
         the 7 selectable themes restyle the entire app consistently. -->
    <style name="Theme.VideoLive" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">?attr/vlAccent</item>
        <item name="colorPrimaryDark">?attr/vlBgTop</item>
        <item name="colorSecondary">?attr/vlAccentSoft</item>
        <item name="colorAccent">?attr/vlAccent</item>
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">?attr/vlBgTop</item>
        <item name="android:navigationBarColor">?attr/vlBgBottom</item>
        <item name="android:textColorPrimary">?attr/vlTextPrimary</item>
        <item name="android:textColorSecondary">?attr/vlTextSecondary</item>
        <item name="android:colorControlActivated">?attr/vlAccent</item>
        <item name="android:colorEdgeEffect">?attr/vlAccent</item>
        <item name="materialAlertDialogTheme">@style/Theme.VideoLive.Dialog</item>
    </style>

    <style name="Theme.VideoLive.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">?attr/vlCard</item>
        <item name="colorPrimary">?attr/vlAccent</item>
        <item name="colorSecondary">?attr/vlAccentSoft</item>
        <item name="android:textColorPrimary">?attr/vlTextPrimary</item>
        <item name="android:textColorSecondary">?attr/vlTextSecondary</item>
    </style>

    <!-- 1 · Graphite (signature studio look) -->
    <style name="Theme.VideoLive.Graphite" parent="Theme.VideoLive">
        <item name="vlBgTop">#0A0F1F</item>
        <item name="vlBgBottom">#0C1226</item>
        <item name="vlCard">#141B33</item>
        <item name="vlStroke">#24304F</item>
        <item name="vlInputBg">#0E1529</item>
        <item name="vlInputStroke">#2A3760</item>
        <item name="vlTextPrimary">#F2F5FF</item>
        <item name="vlTextSecondary">#98A2C4</item>
        <item name="vlTextFaint">#5E6A8F</item>
        <item name="vlAccent">#5B8CFF</item>
        <item name="vlAccentSoft">#2AD4C8</item>
        <item name="vlChipBg">#1B2444</item>
        <item name="vlOptionSelected">#1D2A55</item>
        <item name="vlPreviewBg">#05080F</item>
        <item name="vlOnAccent">#FFFFFF</item>
    </style>

